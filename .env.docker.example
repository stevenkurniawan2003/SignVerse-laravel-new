# Salin ke .env.docker lalu isi nilainya: cp .env.docker.example .env.docker
APP_NAME=SignTeach
APP_ENV=production
APP_DEBUG=false
# Wajib. Di VM (tanpa PHP) buat dengan: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=https://signverse.example.com
APP_PORT=8080
# 127.0.0.1 = hanya bisa diakses lewat reverse proxy (Nginx/Caddy) di VM.
# Ganti ke 0.0.0.0 jika ingin langsung diakses via http://IP-VM:8080
APP_BIND=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=signverse
DB_USERNAME=signverse
DB_PASSWORD=ganti-password-ini
DB_ROOT_PASSWORD=ganti-password-root-ini

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# true jika situs diakses lewat HTTPS
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

GESTURE_RECOGNIZER=ai
SIGNTECH_AI_URL=https://ai.signtech.tech
SIGNTECH_AI_TIMEOUT=15

RUN_MIGRATIONS=true
# Set true HANYA saat deploy pertama untuk mengisi konten & akun demo
RUN_SEEDERS=false
